# Copy this file to .env and fill in your own values. Never commit .env.
# On Render there is no .env file: add the same names in the service's Environment settings
# (docs/deploy-render.md). Render sets PORT itself, so it is not listed here.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
GEMINI_API_KEY=
# mock = saved demo answers only (no AI calls), real = Gemini reads new chats, off = read without AI only
AI_MODE=mock
